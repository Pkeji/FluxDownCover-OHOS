{
  "manifest_version": 3,
  "name": "FluxDown Cover — Download Manager",
  "version": "1.1.0",
  "description": "Send pages/links to FluxDown Cover on HarmonyOS and show live download progress over the local API",
  "permissions": ["contextMenus", "activeTab", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:17800/*",
    "http://localhost:17800/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
